<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
       http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">

    <persistence-unit name="websiteMotorbikePU"
                      transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Sao chép file này thành persistence.xml rồi điền thông tin Supabase (xin qua tin nhắn riêng). Không commit persistence.xml. -->
            <!-- Dùng Session pooler (cổng 5432), user dạng postgres.<project-ref>. Không dùng cổng 6543. -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://YOUR_HOST:5432/postgres?sslmode=require"/>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="YOUR_USER"/>
            <property name="jakarta.persistence.jdbc.password" value="YOUR_PASSWORD"/>
            <!-- Giữ "create": chỉ tạo bảng còn thiếu. KHÔNG dùng drop-and-create-tables vì DB dùng chung. -->
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="create"/>
        </properties>
    </persistence-unit>
</persistence>